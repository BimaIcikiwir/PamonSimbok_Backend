PORT=3000
NODE_ENV=development

# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pamon_simbok?schema=public"

# Auth kasir
JWT_SECRET="ganti-dengan-string-acak-minimal-16-karakter"
JWT_EXPIRES_IN="12h"

# Alamat FE yang boleh akses API (pisahkan dengan koma)
CORS_ORIGIN="http://localhost:5173,http://localhost:3001"

# Pembayaran: "simulator" (tanpa akun apa pun) atau "midtrans" (sandbox/production)
PAYMENT_PROVIDER="simulator"
MIDTRANS_SERVER_KEY=""
MIDTRANS_IS_PRODUCTION="false"

# Batas waktu bayar (menit)
QRIS_EXPIRY_MINUTES=15
CASH_EXPIRY_MINUTES=10
